# Copy this to .env and fill in your values
DATABASE_URL="postgresql://postgres:password@localhost:5432/sca_tracker"
NEXTAUTH_SECRET="your-secret-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Required only for the automated scrape pipeline (scripts/pipeline/run.ts,
# scheduled via .github/workflows/scrape-opportunities.yml). Not needed to
# run the website itself. Set these as GitHub Actions repo secrets, not here.
GEMINI_API_KEY="your-gemini-api-key"          # free at aistudio.google.com/apikey
RESEND_API_KEY="your-resend-api-key"          # free at resend.com
NOTIFY_EMAIL="you@example.com"                # where run summaries get sent
NOTIFY_FROM_EMAIL="onboarding@resend.dev"     # Resend's sandbox sender — works with
                                               # no setup. Switch to a bcusca.org address
                                               # once that domain is verified in Resend.
